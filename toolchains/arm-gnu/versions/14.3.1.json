{
  "$schema": "../../../schemas/devenv.schema.json",
  "apiVersion": "devenv.gizmoth.dev/v1alpha1",
  "kind": "ToolchainRelease",
  "id": "arm-gnu",
  "version": "14.3.1",
  "platforms": {
    "linux-arm64": {
      "requires": [
        "sh",
        "mktemp",
        "rm"
      ],
      "dependencies": [
        {
          "toolchain": "linux-network-libs",
          "version": "12.0.0"
        }
      ],
      "sources": [
        {
          "id": "toolchain",
          "type": "file",
          "url": "https://armkeil.blob.core.windows.net/developer/Files/downloads/gnu/14.3.rel1/binrel/arm-gnu-toolchain-14.3.rel1-aarch64-arm-none-eabi.tar.xz",
          "sha256": "2d465847eb1d05f876270494f51034de9ace9abe87a4222d079f3360240184d3",
          "size": 148423580
        }
      ],
      "install": [
        {
          "type": "extract",
          "source": "toolchain",
          "to": "toolchain",
          "format": "tar.xz",
          "stripComponents": 1
        }
      ],
      "environment": {
        "prependPath": [
          "toolchain/bin"
        ],
        "variables": {
          "GIZOS_BK_TOOLCHAIN_ROOT": "${prefix}/toolchain",
          "TOOLCHAIN_DIR": "${prefix}/toolchain/bin",
          "COMPILER_TOOLCHAIN_PATH": "${prefix}/toolchain/bin"
        }
      },
      "checks": [
        {
          "type": "file",
          "path": "toolchain/bin/arm-none-eabi-gcc",
          "executable": true
        },
        {
          "type": "file",
          "path": "toolchain/lib/gcc/arm-none-eabi/14.3.1/include/stdint.h",
          "executable": false
        },
        {
          "type": "command",
          "program": "${prefix}/toolchain/bin/arm-none-eabi-gcc",
          "args": [
            "--version"
          ],
          "stdoutContains": "14.3.1",
          "timeoutSeconds": 30
        },
        {
          "type": "command",
          "program": "sh",
          "args": [
            "-ec",
            "d=\"$(mktemp -d \"${cache}/arm-gnu-check.XXXXXX\")\"; trap 'rm -rf \"$d\"' EXIT; printf '#include <stdint.h>\\n#include <stdio.h>\\nvoid _start(void) { volatile uint32_t x = 1; (void)x; for (;;) {} }\\n' > \"$d/smoke.c\"; \"${prefix}/toolchain/bin/arm-none-eabi-gcc\" -mcpu=cortex-m55 -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16 -mcmse -nostartfiles -Wl,-e,_start \"$d/smoke.c\" -lm -lc -lnosys -o \"$d/m55.elf\"; \"${prefix}/toolchain/bin/arm-none-eabi-gcc\" -mcpu=cortex-m52+nodsp -mthumb -mfloat-abi=soft -mcmse -nostartfiles -Wl,-e,_start \"$d/smoke.c\" -lm -lc -lnosys -o \"$d/m52.elf\"; test -s \"$d/m55.elf\"; test -s \"$d/m52.elf\"; printf 'gizmoth-arm-gnu-link-ok\\n'"
          ],
          "stdoutContains": "gizmoth-arm-gnu-link-ok",
          "timeoutSeconds": 30
        }
      ]
    },
    "linux-x86_64": {
      "requires": [
        "sh",
        "mktemp",
        "rm"
      ],
      "dependencies": [
        {
          "toolchain": "linux-network-libs",
          "version": "12.0.0"
        }
      ],
      "sources": [
        {
          "id": "toolchain",
          "type": "file",
          "url": "https://armkeil.blob.core.windows.net/developer/Files/downloads/gnu/14.3.rel1/binrel/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi.tar.xz",
          "sha256": "8f6903f8ceb084d9227b9ef991490413014d991874a1e34074443c2a72b14dbd",
          "size": 149789432
        }
      ],
      "install": [
        {
          "type": "extract",
          "source": "toolchain",
          "to": "toolchain",
          "format": "tar.xz",
          "stripComponents": 1
        }
      ],
      "environment": {
        "prependPath": [
          "toolchain/bin"
        ],
        "variables": {
          "GIZOS_BK_TOOLCHAIN_ROOT": "${prefix}/toolchain",
          "TOOLCHAIN_DIR": "${prefix}/toolchain/bin",
          "COMPILER_TOOLCHAIN_PATH": "${prefix}/toolchain/bin"
        }
      },
      "checks": [
        {
          "type": "file",
          "path": "toolchain/bin/arm-none-eabi-gcc",
          "executable": true
        },
        {
          "type": "file",
          "path": "toolchain/lib/gcc/arm-none-eabi/14.3.1/include/stdint.h",
          "executable": false
        },
        {
          "type": "command",
          "program": "${prefix}/toolchain/bin/arm-none-eabi-gcc",
          "args": [
            "--version"
          ],
          "stdoutContains": "14.3.1",
          "timeoutSeconds": 30
        },
        {
          "type": "command",
          "program": "sh",
          "args": [
            "-ec",
            "d=\"$(mktemp -d \"${cache}/arm-gnu-check.XXXXXX\")\"; trap 'rm -rf \"$d\"' EXIT; printf '#include <stdint.h>\\n#include <stdio.h>\\nvoid _start(void) { volatile uint32_t x = 1; (void)x; for (;;) {} }\\n' > \"$d/smoke.c\"; \"${prefix}/toolchain/bin/arm-none-eabi-gcc\" -mcpu=cortex-m55 -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16 -mcmse -nostartfiles -Wl,-e,_start \"$d/smoke.c\" -lm -lc -lnosys -o \"$d/m55.elf\"; \"${prefix}/toolchain/bin/arm-none-eabi-gcc\" -mcpu=cortex-m52+nodsp -mthumb -mfloat-abi=soft -mcmse -nostartfiles -Wl,-e,_start \"$d/smoke.c\" -lm -lc -lnosys -o \"$d/m52.elf\"; test -s \"$d/m55.elf\"; test -s \"$d/m52.elf\"; printf 'gizmoth-arm-gnu-link-ok\\n'"
          ],
          "stdoutContains": "gizmoth-arm-gnu-link-ok",
          "timeoutSeconds": 30
        }
      ]
    }
  }
}
