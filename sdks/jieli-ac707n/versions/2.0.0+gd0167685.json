{
  "$schema": "../../../schemas/devenv.schema.json",
  "apiVersion": "devenv.gizmoth.dev/v1alpha1",
  "kind": "SdkRelease",
  "id": "jieli-ac707n",
  "version": "2.0.0+gd0167685",
  "platforms": {
    "linux-arm64": {
      "requires": [
        "git",
        "git-lfs"
      ],
      "dependencies": [
        {
          "toolchain": "jieli",
          "version": "4.0.1+20250805.1"
        },
        {
          "toolchain": "jieli-postbuild",
          "version": "2026.7.28+1"
        },
        {
          "toolchain": "python",
          "version": "3.12.16"
        },
        {
          "toolchain": "linux-git",
          "version": "12.0.0"
        },
        {
          "toolchain": "linux-build-tools",
          "version": "12.0.0"
        },
        {
          "toolchain": "linux-text-tools",
          "version": "12.0.0"
        },
        {
          "toolchain": "git-lfs",
          "version": "3.8.1"
        }
      ],
      "targets": {
        "ac707n": {
          "dependencies": []
        }
      },
      "sources": [
        {
          "id": "sdk",
          "type": "git",
          "url": "https://github.com/GizClaw/e_badge_707_sdk_200.git",
          "commit": "d0167685d032d745d88fe50233302edd46941622",
          "submodules": true
        }
      ],
      "install": [
        {
          "type": "checkout",
          "source": "sdk",
          "to": "payload/sdk"
        }
      ],
      "environment": {
        "prependPath": [],
        "variables": {
          "JIELI_AC707N_SDK_PATH": "${prefix}/payload/sdk/SDK"
        }
      },
      "checks": [
        {
          "type": "file",
          "path": "payload/sdk/.git/HEAD",
          "executable": false
        },
        {
          "type": "file",
          "path": "payload/sdk/SDK/cpu/br35/sdk_ld.c",
          "executable": false
        },
        {
          "type": "file",
          "path": "payload/sdk/SDK/cpu/br35/tools/download.c",
          "executable": false
        },
        {
          "type": "command",
          "program": "git",
          "args": [
            "-C",
            "${prefix}/payload/sdk",
            "rev-parse",
            "HEAD"
          ],
          "stdoutContains": "d0167685d032d745d88fe50233302edd46941622",
          "timeoutSeconds": 30
        },
        {
          "type": "command",
          "program": "${toolchain:python}/python/bin/python3",
          "args": [
            "-I",
            "-c",
            "import subprocess,sys\nroot=sys.argv[1]\nstatus=subprocess.check_output(['git','-C',root,'status','--porcelain=v1','--untracked-files=all','--ignore-submodules=none'],text=True)\nassert not status, 'SDK checkout is dirty: '+status\nmodules=subprocess.check_output(['git','-C',root,'submodule','status','--recursive'],text=True)\nassert all(line.startswith(' ') for line in modules.splitlines()), 'SDK submodules are missing or mismatched: '+modules\nprint('gizmoth-sdk-clean')",
            "${prefix}/payload/sdk"
          ],
          "stdoutContains": "gizmoth-sdk-clean",
          "timeoutSeconds": 60
        }
      ]
    },
    "linux-x86_64": {
      "requires": [
        "git",
        "git-lfs"
      ],
      "dependencies": [
        {
          "toolchain": "jieli",
          "version": "4.0.1+20250805.1"
        },
        {
          "toolchain": "jieli-postbuild",
          "version": "2026.7.28+1"
        },
        {
          "toolchain": "python",
          "version": "3.12.16"
        },
        {
          "toolchain": "linux-git",
          "version": "12.0.0"
        },
        {
          "toolchain": "linux-build-tools",
          "version": "12.0.0"
        },
        {
          "toolchain": "linux-text-tools",
          "version": "12.0.0"
        },
        {
          "toolchain": "git-lfs",
          "version": "3.8.1"
        }
      ],
      "targets": {
        "ac707n": {
          "dependencies": []
        }
      },
      "sources": [
        {
          "id": "sdk",
          "type": "git",
          "url": "https://github.com/GizClaw/e_badge_707_sdk_200.git",
          "commit": "d0167685d032d745d88fe50233302edd46941622",
          "submodules": true
        }
      ],
      "install": [
        {
          "type": "checkout",
          "source": "sdk",
          "to": "payload/sdk"
        }
      ],
      "environment": {
        "prependPath": [],
        "variables": {
          "JIELI_AC707N_SDK_PATH": "${prefix}/payload/sdk/SDK"
        }
      },
      "checks": [
        {
          "type": "file",
          "path": "payload/sdk/.git/HEAD",
          "executable": false
        },
        {
          "type": "file",
          "path": "payload/sdk/SDK/cpu/br35/sdk_ld.c",
          "executable": false
        },
        {
          "type": "file",
          "path": "payload/sdk/SDK/cpu/br35/tools/download.c",
          "executable": false
        },
        {
          "type": "command",
          "program": "git",
          "args": [
            "-C",
            "${prefix}/payload/sdk",
            "rev-parse",
            "HEAD"
          ],
          "stdoutContains": "d0167685d032d745d88fe50233302edd46941622",
          "timeoutSeconds": 30
        },
        {
          "type": "command",
          "program": "${toolchain:python}/python/bin/python3",
          "args": [
            "-I",
            "-c",
            "import subprocess,sys\nroot=sys.argv[1]\nstatus=subprocess.check_output(['git','-C',root,'status','--porcelain=v1','--untracked-files=all','--ignore-submodules=none'],text=True)\nassert not status, 'SDK checkout is dirty: '+status\nmodules=subprocess.check_output(['git','-C',root,'submodule','status','--recursive'],text=True)\nassert all(line.startswith(' ') for line in modules.splitlines()), 'SDK submodules are missing or mismatched: '+modules\nprint('gizmoth-sdk-clean')",
            "${prefix}/payload/sdk"
          ],
          "stdoutContains": "gizmoth-sdk-clean",
          "timeoutSeconds": 60
        }
      ]
    }
  }
}
