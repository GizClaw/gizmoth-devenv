        {
          "type": "extract",
          "source": "toolchain",
          "to": "toolchain",
          "format": "tar.xz",
          "stripComponents": 1
        }
      ],
      "environment": {
        "prependPath": [
          "toolchain/bin"
        ],
        "variables": {}
      },
      "checks": [
