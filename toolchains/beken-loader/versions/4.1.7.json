{
  "$schema": "../../../schemas/devenv.schema.json",
  "apiVersion": "devenv.gizmoth.dev/v1alpha1",
  "kind": "ToolchainRelease",
  "id": "beken-loader",
  "version": "4.1.7",
  "platforms": {
    "linux-arm64": {
      "requires": [],
      "dependencies": [{ "toolchain": "linux-runtime", "version": "12.0.0" }],
      "sources": [{
        "id": "bk-loader", "type": "file",
        "url": "https://github.com/GizClaw/bk_loader/releases/download/v4.1.7/bk-loader-4.1.7-linux-arm64.tar.gz",
        "sha256": "8786a05b5ffed04c3e8b2d1dcb80482d4e3530094e19512dff5dd9ee9e9a77e5",
        "size": 30305407
      }],
      "install": [{ "type": "extract", "source": "bk-loader", "to": "payload", "format": "tar.gz", "stripComponents": 0 }],
      "environment": { "prependPath": ["payload/bin"], "variables": { "BK_LOADER_BIN": "${prefix}/payload/bin/bk_loader" } },
      "checks": [
        { "type": "file", "path": "payload/bin/bk_loader", "executable": true },
        { "type": "file", "path": "payload/LICENSE", "executable": false },
        { "type": "file", "path": "payload/NOTICE.md", "executable": false },
        { "type": "file", "path": "payload/SOURCE.json", "executable": false },
        { "type": "command", "program": "${prefix}/payload/bin/bk_loader", "args": ["--version"], "stdoutContains": "bk_loader, version 4.1.7.250", "timeoutSeconds": 60 },
        { "type": "command", "program": "${prefix}/payload/bin/bk_loader", "args": ["tools", "selftest"], "stdoutContains": "\"packageVersion\": \"4.1.7\"", "timeoutSeconds": 60 }
      ]
    },
    "linux-x86_64": {
      "requires": [],
      "dependencies": [{ "toolchain": "linux-runtime", "version": "12.0.0" }],
      "sources": [{
        "id": "bk-loader", "type": "file",
        "url": "https://github.com/GizClaw/bk_loader/releases/download/v4.1.7/bk-loader-4.1.7-linux-x64.tar.gz",
        "sha256": "e65e4731da9957039014e0a5ae79cb53a17c1801757d4cf79725606c847d34bb",
        "size": 31362878
      }],
      "install": [{ "type": "extract", "source": "bk-loader", "to": "payload", "format": "tar.gz", "stripComponents": 0 }],
      "environment": { "prependPath": ["payload/bin"], "variables": { "BK_LOADER_BIN": "${prefix}/payload/bin/bk_loader" } },
      "checks": [
        { "type": "file", "path": "payload/bin/bk_loader", "executable": true },
        { "type": "file", "path": "payload/LICENSE", "executable": false },
        { "type": "file", "path": "payload/NOTICE.md", "executable": false },
        { "type": "file", "path": "payload/SOURCE.json", "executable": false },
        { "type": "command", "program": "${prefix}/payload/bin/bk_loader", "args": ["--version"], "stdoutContains": "bk_loader, version 4.1.7.250", "timeoutSeconds": 60 },
        { "type": "command", "program": "${prefix}/payload/bin/bk_loader", "args": ["tools", "selftest"], "stdoutContains": "\"packageVersion\": \"4.1.7\"", "timeoutSeconds": 60 }
      ]
    }
  }
}
