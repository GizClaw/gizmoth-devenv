        }
      ],
      "install": [
        {
          "type": "extract",
          "source": "toolchain",
          "to": "toolchain",
          "format": "tar.gz",
          "stripComponents": 1
        }
      ],
      "environment": {
        "prependPath": [
          "toolchain/bin"
        ],
        "variables": {}
      },
      "checks": [
