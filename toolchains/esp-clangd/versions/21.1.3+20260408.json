          "size": 14706612,
          "url": "https://github.com/espressif/llvm-project/releases/download/esp-21.1.3_20260408/clangd-esp-21.1.3_20260408-aarch64-linux-gnu.tar.xz"
        }
      ],
      "install": [
        {
          "type": "extract",
          "source": "archive",
          "to": "toolchain",
          "format": "tar.xz",
