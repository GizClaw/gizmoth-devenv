            "-MGit",
            "-MError",
            "-MFile::Spec",
            "-MIPC::Open3",
            "-MDigest::SHA",
            "-MGDBM_File",
            "-e",
            "print \"gizmoth-git-perl-ok\\n\""
          ],
          "stdoutContains": "gizmoth-git-perl-ok",
          "timeoutSeconds": 10
        },
        {
          "type": "command",
          "program": "${toolchain:linux-runtime}/bin/bash",
          "args": [
            "-euc",
            "prefix=$1\ngit=\"$prefix/usr/bin/git\"\ntest \"$(\"$git\" --exec-path)\" = \"$prefix/usr/lib/git-core\"\nwork=$(mktemp -d)\ntrap 'rm -rf \"$work\"' EXIT\nexport GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0\n\"$git\" -c init.defaultBranch=main init \"$work/source\"\ntest -f \"$work/source/.git/hooks/pre-commit.sample\"\ncmp \"$prefix/usr/share/git-core/templates/description\" \"$work/source/.git/description\"\nprintf 'gizmoth-git-qualified\\n' > \"$work/source/fixture\"\n\"$git\" -C \"$work/source\" add fixture\n\"$git\" -C \"$work/source\" -c user.name=GizMoth -c user.email=qualification@example.invalid -c commit.gpgsign=false commit -m qualification\n\"$git\" clone --no-hardlinks \"$work/source\" \"$work/clone\"\ncmp \"$work/source/fixture\" \"$work/clone/fixture\"\ntest \"$(\"$git\" -C \"$work/source\" rev-parse HEAD)\" = \"$(\"$git\" -C \"$work/clone\" rev-parse HEAD)\"\nprintf 'q\\n' | \"$git\" -C \"$work/source\" -c add.interactive.useBuiltin=false add --interactive\n# Remote-helper capabilities load libcurl without any network request.\nprintf 'capabilities\\n\\n' | \"$prefix/usr/lib/git-core/git-remote-https\" origin https://example.invalid | grep -q '^fetch$'\nprintf 'gizmoth-git-qualified\\n'",
            "gizmoth-git-check",
            "${prefix}"
          ],
          "stdoutContains": "gizmoth-git-qualified",
          "timeoutSeconds": 30
        }
      ]
