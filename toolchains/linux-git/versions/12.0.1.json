            "-euc",
            "prefix=$1\nfor payload in \"$prefix\"/payloads/*; do\n  cp -a \"$payload/.\" \"$prefix/\"\ndone\nrm -rf \"$prefix/payloads\"\n# Debian Perl scripts name an interpreter outside this versioned installation.\nfor file in \"$prefix\"/usr/bin/* \"$prefix\"/usr/lib/git-core/* \"$prefix\"/usr/share/git-core/templates/hooks/*; do\n  if [ -f \"$file\" ] && [ ! -L \"$file\" ] && LC_ALL=C grep -Iq '^#!/usr/bin/perl' \"$file\"; then\n    sed -i.gizmoth \"1s|^#!/usr/bin/perl|#!$prefix/usr/bin/perl|\" \"$file\"\n    rm \"$file.gizmoth\"\n  fi\ndone",
